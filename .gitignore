# Toolchains and device tools, downloaded locally (NDK, .NET, adb, validation layer); tools/ also holds the APK signing key
/tools/
# Scratch work and probe outputs (some are made from game files)
/work/
/build/

# Android build outputs
/nxnative/dm/android/out/
*.apk
*.spv
*.dmsv
__pycache__/

# Debug symbols: they embed the build machine's local paths and nothing else
*.pdb

# Keys: never committed
*-signing-key.json
*.keystore
prod.keys
title.keys
/devtools/device.json

# Game dumps: NSPs decompressed from NSZ, the ports made from them (APK, data pack, build folders); one folder per game, .gamedump/<game>/
/.gamedump/

# Python environment (python -m venv .venv)
/.venv/

# The player bundle (python packaging/build_bundle.py)
/dist/

# The phone app: the payload it ships (the rootfs, the build tools) and the Gradle build
/packaging/android-apk/.cache/
/android/build/
/android/app/build/
/android/.gradle/
/android/local.properties
