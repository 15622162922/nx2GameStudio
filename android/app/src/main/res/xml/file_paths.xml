<?xml version="1.0" encoding="utf-8"?>
<!-- The paths the save packages are shared from: the download folder's nx2android/ (where the panel writes
     them) and the app's own external files folder (the fallback when the download folder cannot be written). -->
<paths>
    <external-path name="downloads" path="Download/nx2android/" />
    <external-files-path name="external-files" path="nx2android/" />
</paths>
