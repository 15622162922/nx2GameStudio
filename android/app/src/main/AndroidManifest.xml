<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The game files, the ports it makes and the .NET SDK it downloads are on the shared storage. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- The .NET SDK comes from Microsoft's servers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installing the port the tool makes. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The game files and the ports the tool makes are on the shared storage: from Android 11 the old
         permissions are not enough, the app needs the all-files access (the user gives it once). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the APK the tool made to the system installer (a file:// URI is not allowed since Android 7). -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.nx.android.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
